{
  "name": "momentum-server",
  "version": "1.0.0",
  "description": "Momentum Backend API",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "seed": "node -r dotenv/config prisma/seed.js"
  },
  "vitest": {
    "environment": "node",
    "globals": true,
    "pool": "forks",
    "poolOptions": {
      "forks": {
        "singleFork": true
      }
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "groq-sdk": "^1.6.0",
    "jsonwebtoken": "^9.0.3",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.3",
    "nodemon": "^3.1.7",
    "prisma": "^5.22.0",
    "supertest": "^7.3.1",
    "vitest": "^5.0.3"
  }
}
